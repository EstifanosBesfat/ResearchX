# ResearchX uses one OpenAI-compatible embeddings model for ingest and query.
# EMBEDDING_DIMENSION is 1536 and must match chunks.embedding vector(1536)
# in apps/api/sql/001_init.sql. Do not point the two sides at different models
# or a second vector size.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# OpenAI-compatible embeddings (OpenAI, or a Neon AI Gateway /v1 dialect).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Set to true to send {"dimensions": 1536} (text-embedding-3 does this automatically).
EMBEDDING_SEND_DIMENSIONS=

# OpenAI-compatible chat completions. The API stores structured JSON only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Neon AI Gateway (paid plan, supported region) is OpenAI-compatible.
# Neon injects NEON_AI_GATEWAY_BASE_URL (host only) and NEON_AI_GATEWAY_TOKEN.
# Point both clients at the gateway and keep EMBEDDING_DIMENSION=1536:
# EMBEDDING_BASE_URL=${NEON_AI_GATEWAY_BASE_URL}/v1
# EMBEDDING_API_KEY=${NEON_AI_GATEWAY_TOKEN}
# LLM_BASE_URL=${NEON_AI_GATEWAY_BASE_URL}/v1
# LLM_API_KEY=${NEON_AI_GATEWAY_TOKEN}

API_PORT=3001
# Extra allowed browser origins. localhost and 127.0.0.1 on any port are allowed in development.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Cosine similarity. Chunks below this floor do not support a report.
SIMILARITY_FLOOR=0.22
